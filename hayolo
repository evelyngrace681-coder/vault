  background: #111;
  border-radius: 8px;
  display: inline-block;
  z-index: 0;
  cursor: pointer;
  letter-spacing: 1px;
  white-space: nowrap;
}
.btn-glow,
.btn-glow:hover,
.btn-glow:visited {
  color: #ffffff !important;
}
.btn-glow::before {
  content: '';
  background: linear-gradient(88deg, #ed06b7, #0e0e0e, #ed06b7, #0e0e0e, #ed06b7, #0e0e0e, #ed06b7, #0e0e0e);
  position: absolute;
  top: -2px;
  left: -2px;
  width: calc(100% + 4px);
  height: calc(100% + 4px);
  background-size: 400%;
  z-index: -1;
  filter: blur(5px);
  border-radius: 10px;
  animation: glowing 20s linear infinite;
  opacity: 1;
}

.btn-glow::after {
  content: '';
  position: absolute;
  z-index: -1;
  width: 100%;
  height: 100%;
  background: #111;
  left: 0;
  top: 0;
  border-radius: 10px;
}

@keyframes glowing {
  0%   { background-position: 0 0; }
  50%  { background-position: 400% 0; }
  100% { background-position: 0 0; }
}

